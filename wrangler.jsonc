{
  "compatibility_date": "2026-04-07",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "name": "hyperui",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "analytics_engine_datasets": [
    {
      "binding": "COPY_EVENTS",
      "dataset": "hyperui_copies"
    }
  ],
  "observability": {
    "enabled": false
  }
}
