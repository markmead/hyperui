---
import { getCollection } from 'astro:content'

import { SEO_TITLE_SITE, SEO_DESCRIPTION_SITE } from '../constants/seo'

import BaseLayout from '../layouts/BaseLayout.astro'
import CollectionFeature from '../components/CollectionFeature.astro'
import HomeHero from '../components/HomeHero.astro'

const [templatesRaw, applicationRaw, marketingRaw, neobrutalismRaw] = await Promise.all([
  getCollection('templates'),
  getCollection('application'),
  getCollection('marketing'),
  getCollection('neobrutalism'),
])

const templates = templatesRaw
  .map(({ data }) => data)
  .sort((a, b) => a.title.localeCompare(b.title))

const application = applicationRaw
  .map(({ data }) => data)
  .sort((a, b) => a.title.localeCompare(b.title))
  .slice(0, 9)

const marketing = marketingRaw
  .map(({ data }) => data)
  .sort((a, b) => a.title.localeCompare(b.title))
  .slice(0, 9)

const neobrutalism = neobrutalismRaw
  .map(({ data }) => data)
  .sort((a, b) => a.title.localeCompare(b.title))
  .slice(0, 9)
---

<BaseLayout title={SEO_TITLE_SITE} description={SEO_DESCRIPTION_SITE}>
  <main id="main-content">
    <HomeHero />

    <div class="mx-auto max-w-7xl divide-y divide-gray-200 px-4">
      <CollectionFeature
        title="Templates"
        description="Full pages built from HyperUI components. Accessible, responsive and dark mode ready."
        slug="templates"
        components={templates}
        linkLabel="View all templates"
      />

      <CollectionFeature
        title="Application Components"
        description="Components for building application user interfaces."
        slug="application"
        components={application}
      />

      <CollectionFeature
        title="Marketing Components"
        description="Components for building marketing websites and landing pages."
        slug="marketing"
        components={marketing}
      />

      <CollectionFeature
        title="Neobrutalism Components"
        description="Components for building neobrutalist designs."
        slug="neobrutalism"
        components={neobrutalism}
      />

      <section class="py-16">
        <div
          class="flex flex-col items-start gap-x-8 gap-y-4 rounded-lg border border-gray-200 bg-gray-50 p-8 sm:flex-row sm:items-center sm:justify-between"
        >
          <div>
            <h2 class="text-2xl font-medium">HyperUI Tools</h2>

            <p class="mt-2 text-gray-600">
              Paste any Tailwind markup and generate dark mode variants, all in the browser.
            </p>
          </div>

          <a
            href="/tools"
            class="inline-flex items-center justify-center gap-2 rounded-md border border-gray-900 bg-gray-900 px-4 py-2 text-sm font-medium text-white transition-colors hover:border-gray-800 hover:bg-gray-800"
          >
            Browse tools
          </a>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
