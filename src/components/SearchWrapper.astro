---
import { getCollection } from 'astro:content'

import SearchInput from './SearchInput.astro'
import SearchResults from './SearchResults.astro'
import { countLabel } from '../lib/count-label'

interface Result {
  category: string
  count?: string
  description?: string
  slug: string
  terms: string[]
  title: string
}

const [application, marketing, neobrutalism, templates, pages] = await Promise.all([
  getCollection('application'),
  getCollection('marketing'),
  getCollection('neobrutalism'),
  getCollection('templates'),
  getCollection('pages'),
])

const allCollections = [...application, ...marketing, ...neobrutalism, ...templates]
  .map(({ data }) => data)
  .sort((a, b) => a.title.localeCompare(b.title))

const collections: Result[] = allCollections.map(
  ({ category, components, description, slug, terms, title }) => {
    return {
      category,
      count: countLabel({ category, components }),
      description,
      slug: `/components/${category}/${slug}`,
      terms,
      title,
    }
  },
)

const posts: Result[] = pages.map(({ data }) => {
  return {
    category: '',
    description: data.description,
    slug: `/${data.slug}`,
    terms: data.terms,
    title: data.title,
  }
})
---

<div class="relative">
  <SearchInput />
  <SearchResults {collections} {posts} />
</div>
