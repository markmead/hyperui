---
import { Sparkles } from '@lucide/astro'

interface Props {
  src: string
  header: string
}

const { src, header } = Astro.props
---

<preview-copy-ai data-src={src} data-header={header}>
  <button
    type="button"
    aria-label="Copy HTML with context for an AI assistant"
    title="Copy for AI"
    aria-pressed="false"
    class="inline-flex items-center justify-center gap-2 rounded-md border border-gray-200 bg-white px-3 py-1.5 text-sm font-medium text-gray-900 transition-colors hover:bg-gray-50 disabled:pointer-events-none disabled:opacity-50"
  >
    <Sparkles class="size-4" />

    <!-- Icon only below lg so the toolbar fits at tablet widths. -->
    <span data-text class="hidden lg:inline">Copy for AI</span>
  </button>

  <span data-polite aria-live="polite" class="sr-only"> </span>
</preview-copy-ai>

<script>
  import { copyTextToClipboard } from '../lib/clipboard.js'

  function codeFence(code: string): string {
    const longestRun = Math.max(2, ...(code.match(/`+/g) ?? []).map((run) => run.length))
    const fence = '`'.repeat(longestRun + 1)

    return `${fence}html\n${code}\n${fence}`
  }

  class PreviewCopyAi extends HTMLElement {
    private isProcessing = false
    private timeoutId: ReturnType<typeof setTimeout> | null = null

    private clickHandler: (() => void) | null = null

    connectedCallback() {
      const contentSrc = this.dataset.src
      const header = this.dataset.header ?? ''

      const buttonEl = this.querySelector('button')
      const politeEl = this.querySelector<HTMLElement>('span[data-polite]')
      const buttonText = buttonEl?.querySelector<HTMLElement>('span[data-text]')

      if (!contentSrc || !buttonEl || !politeEl || !buttonText) {
        return
      }

      this.clickHandler = async () => {
        if (this.isProcessing) {
          return
        }

        // Reuse the HTML <component-preview> already renders for the code view.
        const html = document
          .querySelector(`component-preview[data-src="${CSS.escape(contentSrc)}"] [data-html]`)
          ?.textContent?.trim()

        if (!html) {
          return
        }

        this.isProcessing = true

        this.timeoutId = await copyTextToClipboard(`${header}\n\n${codeFence(html)}\n`, {
          buttonTextElement: buttonText,
          liveRegionElement: politeEl,
          buttonElement: buttonEl,
          existingTimerId: this.timeoutId,
          resetText: 'Copy for AI',
          onReset: () => {
            this.isProcessing = false
          },
        })

        if (buttonText.textContent !== 'Copied') {
          this.isProcessing = false
        }
      }

      buttonEl.addEventListener('click', this.clickHandler)
    }

    disconnectedCallback() {
      const buttonEl = this.querySelector('button')

      if (buttonEl && this.clickHandler) {
        buttonEl.removeEventListener('click', this.clickHandler)

        this.clickHandler = null
      }

      if (this.timeoutId !== null) {
        clearTimeout(this.timeoutId)

        this.timeoutId = null
      }
    }
  }

  customElements.define('preview-copy-ai', PreviewCopyAi)
</script>
