---
import type { CollectionEntry } from 'astro:content'

import { ArrowRight } from '@lucide/astro'

import CollectionSkeleton from './CollectionSkeleton.astro'
import StatusBadge from './StatusBadge.astro'
import { countLabel } from '../lib/count-label'

interface Props {
  component:
    | CollectionEntry<'application'>['data']
    | CollectionEntry<'marketing'>['data']
    | CollectionEntry<'neobrutalism'>['data']
    | CollectionEntry<'templates'>['data']
}

const { component } = Astro.props

const { category, components, slug, title, updated } = component

const count = countLabel({ category, components })

const daysAgo = (days: number) => {
  const thresholdDate = new Date()

  thresholdDate.setHours(0, 0, 0, 0)
  thresholdDate.setDate(thresholdDate.getDate() - days)

  return thresholdDate
}

// `pnpm thumbnails` writes one for every template.
const thumbnail = category === 'templates' ? `/thumbnails/templates/${slug}.webp` : null

const isNew = updated?.created ? new Date(updated.created) >= daysAgo(30) : false

const isRecentlyUpdated = updated?.date ? new Date(updated.date) >= daysAgo(7) : false
---

<li>
  <a
    href={`/components/${category}/${slug}`}
    class="group flex h-full flex-col overflow-hidden rounded-lg border border-gray-200 bg-white transition hover:-translate-y-1 hover:border-gray-300 hover:shadow-lg"
  >
    {
      thumbnail && (
        <img
          src={thumbnail}
          alt=""
          width="1280"
          height="800"
          loading="lazy"
          decoding="async"
          class="aspect-[16/10] w-full border-b border-gray-200 object-cover object-top"
        />
      )
    }

    {
      !thumbnail && (
        <div class="border-b border-gray-200 bg-gray-50">
          <CollectionSkeleton slug={slug} class="mx-auto h-28 w-full" />
        </div>
      )
    }

    <div class="flex flex-1 flex-col p-6">
      <div class="flex items-start justify-between gap-3">
        <h3 class="text-xl font-medium text-gray-900">
          {title}
        </h3>

        {isNew && <StatusBadge status="fresh" class="mt-1" />}
        {!isNew && isRecentlyUpdated && <StatusBadge status="updated" class="mt-1" />}
      </div>

      <div class="mt-auto flex items-center justify-between pt-2">
        <p class="text-sm text-gray-600">
          {count}
        </p>

        <ArrowRight
          class="size-5 text-gray-400 opacity-0 transition group-hover:translate-x-1 group-hover:opacity-100"
        />
      </div>
    </div>
  </a>
</li>
