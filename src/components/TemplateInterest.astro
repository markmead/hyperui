---
import { Sparkles } from '@lucide/astro'

interface Props {
  /** The template's slug, sent with the click. */
  slug: string
}

const { slug } = Astro.props
---

<template-interest data-slug={slug} class="mx-auto block max-w-7xl px-4 pb-8">
  <div
    class="flex flex-col gap-6 rounded-lg bg-gray-900 p-8 text-white shadow-lg sm:flex-row sm:items-center sm:justify-between"
  >
    <div class="flex items-start gap-4">
      <div class="shrink-0 rounded-lg bg-white/10 p-2.5">
        <Sparkles class="size-6 text-white" />
      </div>

      <div>
        <span
          class="inline-block rounded-full bg-white/10 px-2.5 py-0.5 text-xs font-medium text-gray-100"
        >
          In the works
        </span>

        <h2 class="mt-2 text-xl font-semibold">A full site version</h2>

        <p class="mt-2 max-w-2xl text-gray-300">
          A full multi-page version is in the works: pricing, docs, changelog, sign in and a
          dashboard. Want it?
        </p>
      </div>
    </div>

    <button
      type="button"
      data-interest
      class="shrink-0 rounded-md bg-white px-5 py-2.5 text-sm font-semibold text-gray-900 transition-colors hover:bg-gray-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white aria-disabled:cursor-default aria-disabled:bg-white/10 aria-disabled:text-white"
    >
      I'm interested
    </button>
  </div>

  <span data-interest-status aria-live="polite" class="sr-only"></span>
</template-interest>

<script>
  const STORAGE_PREFIX = 'hyperui:interest:'

  class TemplateInterest extends HTMLElement {
    connectedCallback() {
      const slug = this.dataset.slug
      const button = this.querySelector<HTMLButtonElement>('button[data-interest]')
      const status = this.querySelector<HTMLElement>('[data-interest-status]')

      if (!slug || !button || !status) {
        return
      }

      if (this.hasRegistered(slug)) {
        this.showRegistered(button)
      }

      button.addEventListener('click', () => {
        if (button.getAttribute('aria-disabled') === 'true') {
          return
        }

        // Counted on the server with the slug only (see `src/pages/api/interest.ts`).
        try {
          navigator.sendBeacon('/api/interest', JSON.stringify({ slug }))
        } catch {
          // Counting must never get in the way of the page.
        }

        try {
          localStorage.setItem(`${STORAGE_PREFIX}${slug}`, '1')
        } catch {
          // Storage can be blocked. The button still works for this visit.
        }

        this.showRegistered(button)
        status.textContent = 'Thanks. Your interest has been noted.'
      })
    }

    private hasRegistered(slug: string): boolean {
      try {
        return localStorage.getItem(`${STORAGE_PREFIX}${slug}`) === '1'
      } catch {
        return false
      }
    }

    private showRegistered(button: HTMLButtonElement) {
      // aria-disabled rather than disabled, so focus stays on the button.
      button.setAttribute('aria-disabled', 'true')
      button.textContent = 'Thanks, noted'
    }
  }

  customElements.define('template-interest', TemplateInterest)
</script>
