---
import { BadgeCheck } from '@lucide/astro'
---

<div class="mx-auto max-w-7xl px-4 pb-8">
  <div class="flex items-start gap-4 rounded-lg border border-gray-200 bg-gray-50 p-8">
    <BadgeCheck class="mt-0.5 size-6 shrink-0 text-gray-500" />

    <div>
      <h2 class="text-xl font-medium">Ready to build on</h2>

      <p class="mt-2 text-gray-600">
        Accessible, responsive and dark mode ready. Swap in your own content, then connect your
        forms, data and actions.
      </p>
    </div>
  </div>
</div>
