---
import { ExternalLink } from '@lucide/astro'
---

<footer class="mt-8 border-t border-gray-200 md:mt-16">
  <div class="mx-auto max-w-7xl px-4 pt-8 md:pt-12">
    <aside
      aria-label="HyperUX"
      class="flex flex-col gap-4 rounded-lg border border-gray-200 bg-gray-50 p-4 md:flex-row md:items-center md:justify-between md:p-6"
    >
      <div class="space-y-1">
        <p class="font-medium text-gray-900">Need the JavaScript too?</p>

        <p class="text-sm text-gray-700">
          HyperUX has JavaScript patterns for dialogs, dropdowns, tabs and more, made to go with
          HyperUI components.
        </p>
      </div>

      <a
        href="https://js.hyperui.dev"
        target="_blank"
        rel="noreferrer"
        class="inline-flex shrink-0 items-center justify-center gap-1.5 rounded-md border border-gray-200 bg-white px-3 py-2 text-sm font-medium text-gray-900 transition-colors hover:bg-gray-100"
      >
        Browse HyperUX
        <ExternalLink class="size-4 shrink-0" aria-hidden="true" />
      </a>
    </aside>
  </div>

  <div
    class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-4 px-4 py-6 text-sm text-gray-700 md:flex-row md:py-12"
  >
    <p>
      Built by <a
        href="https://github.com/markmead"
        target="_blank"
        rel="noreferrer"
        class="underline transition-colors hover:text-gray-900">Mark Mead</a
      >
    </p>

    <nav aria-label="Footer">
      <a
        href="/faqs"
        class="rounded-sm font-medium text-gray-900 underline decoration-gray-300 underline-offset-4 transition-colors hover:decoration-gray-900 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gray-900"
      >
        FAQs
      </a>
    </nav>

    <p>
      Released under the <a
        href="https://github.com/markmead/hyperui/blob/main/LICENSE"
        target="_blank"
        rel="noreferrer"
        class="underline transition-colors hover:text-gray-900">MIT License</a
      >
    </p>
  </div>
</footer>
